<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net462;net8.0-windows;net10.0-windows</TargetFrameworks>
        <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
        <UseWPF>true</UseWPF>
        <LangVersion>14</LangVersion>
        <Description>OxyPlot is a plotting library for .NET. This package is the base for WPF PlotView implementations.</Description>
        <GenerateDocumentationFile>True</GenerateDocumentationFile>
        <PackageTags>plotting plot charting chart wpf</PackageTags>
        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>OxyPlot.Wpf.Shared.snk</AssemblyOriginatorKeyFile>
    </PropertyGroup>
    <ItemGroup>
        <None Include="OxyPlot.Wpf.Shared.snk" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\OxyPlot\OxyPlot.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Update="DotNet.ReproducibleBuilds" Version="2.0.2" />
    </ItemGroup>
</Project>
